# The games gallery's table (dm/tools/docs_gallery.py writes README.md's gallery from it): a new game is a row at its end. README.md itself is not merged this way; after a
# conflict in its gallery, run docs_gallery.py. test_docs fails on a game in the table twice
docs/images/gallery.tsv merge=union

# nxnative fork (xbunax): the few rules that must sit at the root. The file merges
# with the union driver so an upstream edit next to this block never conflicts.
.gitattributes merge=union
start-webui.sh text eol=lf
start-webui.command text eol=lf
start-webui.bat text eol=crlf
.github/workflows/*.yml text eol=lf
